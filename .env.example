# Production: provide a strong value, for example 32+ random bytes.
# Health is the only unauthenticated route.
NOPE_API_KEYS=admin-change-me:admin,approver-change-me:approver,agent-change-me:agent,challenger-change-me:agent,ci-change-me:ci
NOPE_ENV=production
NOPE_ALLOW_ANONYMOUS=false

# Use PostgreSQL in production; the default is intentionally local-only SQLite.
DATABASE_URL=postgresql+psycopg://nope:nope@postgres:5432/nope

# Legacy findings are report-only. New findings fail after baseline mode is enabled.
NOPE_BASELINE_ENFORCE=false
NOPE_BASE_REF=origin/main

# Where nope-core may write validation artefacts. Mount this as a volume.
NOPE_WORKDIR=/var/lib/nope

# GitHub webhook verification. Leave blank to reject webhooks in production.
GITHUB_WEBHOOK_SECRET=replace-with-the-github-app-secret
# Read-only repository contents access for verifying the merged rule's exact hash.
GITHUB_TOKEN=
GITHUB_ORG=your-org
GITHUB_REPO=your-repo

# Optional model-independent correlation ID and policy thresholds.
NOPE_MIN_BAD_FIXTURE_HITS=1
NOPE_MAX_GOOD_FIXTURE_HITS=0

# NOPE application settings, not official Switch environment names.
NOPE_SWITCH_ENABLED=false
NOPE_SWITCH_BASE_URL=
NOPE_SWITCH_ROOM_ID=
NOPE_SWITCH_ROOM_URL=
NOPE_SWITCH_BRIDGE_NAME=
NOPE_SWITCH_AGENT_NAME=nope
# Reuse Console's existing agent credentials through the process environment.
# Do not copy keys into this example, room documents, or source control.
# These are the runtime names observed in Console's agent credential file.
SWITCH_API_ENDPOINT=
SWITCH_API_TOKEN=
# The previous SWITCH_BRIDGE_URL/SWITCH_ROOM_ID settings remain compatible aliases.
SWITCH_BRIDGE_URL=
SWITCH_ROOM_ID=
SWITCH_AGENT_ID=
SWITCH_AGENT_KEY=
# Needed only for probes/targeted handoffs/room-document creation in Console's
# existing session; notifications need no event connection.
SWITCH_CONNECTION_ID=
